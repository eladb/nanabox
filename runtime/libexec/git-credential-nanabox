#!/bin/sh
# git-credential-nanabox — shared git credential helper for nanaboxes
# (eladb/nanabox#46).
#
# Resolves github.com / gist.github.com credentials by FILE-READING GH_TOKEN
# from the box-local shared store (/etc/nanabox/shared/shared.env). This is the
# fix for the env-dependent helper that #39 seeded: that old helper only worked
# where something had already exported GH_TOKEN, so `agents new --repo <private>`
# clones — which run as `sudo -u <handle> -H git clone ...`, an env_reset'd
# subprocess with no GH_TOKEN, no GIT_CONFIG_GLOBAL and no ~/.gitconfig — failed
# to authenticate. By reading the token from the file, this helper works box-wide
# for every git context (the agent session, root, and sudo subprocesses) once
# /etc/gitconfig includes the shared gitconfig.
#
# Wired in via the shared gitconfig (postinst):
#   [credential "https://github.com"]
#       helper = /usr/libexec/nanabox/git-credential-nanabox
#
# On `get` it prints:
#   username=x-access-token
#   password=<GH_TOKEN from shared.env>
# On store/erase/anything else it no-ops cleanly (git stores creds in the file,
# not via this helper). If GH_TOKEN is absent/unreadable it emits nothing and
# git fails closed — exactly the intended behavior for a non-`agents` principal
# who can't read the 0640 root:agents store.
#
# Rotation = update shared.env's GH_TOKEN; nothing here changes.
#
# Security: the token is NEVER placed on a command line (file content only), so
# it stays out of `ps`, shell history and `git remote -v`. We do NOT `source`
# the store (a stray line can't run code) — we grep the single key, mirroring
# the harness's load_env_allowlisted (runtime/libexec/harness:60-79) EXACTLY:
# optional leading `export `, last assignment wins, surrounding whitespace
# trimmed, one layer of single/double quotes stripped.
set -eu

# Store path is overridable (so tests can point at a fixture); defaults to the
# real shared store.
SHARED_ENV="${NANABOX_SHARED_ENV:-/etc/nanabox/shared/shared.env}"

# git invokes a credential helper as: <helper> <operation> [args...]
op="${1:-}"

# Only `get` resolves a credential. store/erase/empty/anything-else no-op.
[ "$op" = "get" ] || exit 0

# read_key KEY FILE — print the resolved value of KEY from FILE, or nothing.
# Mirrors the harness's load_env_allowlisted parsing exactly.
read_key() {
  _k="$1"
  _file="$2"
  [ -r "$_file" ] || return 0
  # Last matching assignment in the file wins.
  _line=$(grep -E "^[[:space:]]*(export[[:space:]]+)?$_k=" "$_file" 2>/dev/null | tail -n 1)
  [ -n "$_line" ] || return 0
  # Strip a leading `export `, then everything up to and including the `=`.
  _val=${_line#*=}
  # Trim surrounding whitespace.
  _val=$(printf '%s' "$_val" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
  # Unquote a fully double- or single-quoted value.
  case "$_val" in
    \"*\") _val=${_val#\"}; _val=${_val%\"} ;;
    \'*\') _val=${_val#\'}; _val=${_val%\'} ;;
  esac
  [ -n "$_val" ] || return 0
  printf '%s' "$_val"
}

# Prefer a per-box GitHub App installation token when this box has its own App
# configured (eladb/nanabox#219). nanabox-gh-token prints a fresh, short-lived
# token and exits 0; if no App is configured (the common case) or anything fails
# it exits non-zero and prints nothing, so we fall back to the static GH_TOKEN
# below — i.e. a box without an App behaves EXACTLY as before. Both authenticate
# to github.com as the `x-access-token` username.
GH_TOKEN_HELPER="${NANABOX_GH_TOKEN_BIN:-/usr/libexec/nanabox/nanabox-gh-token}"
token=""
if [ -x "$GH_TOKEN_HELPER" ]; then
  token=$("$GH_TOKEN_HELPER" 2>/dev/null) || token=""
fi

# Fall back to the static shared GH_TOKEN (the pre-#219 behavior).
[ -n "$token" ] || token=$(read_key GH_TOKEN "$SHARED_ENV")

# No token resolvable → emit nothing; git treats it as "no credential" and fails
# closed. Don't print a half-credential.
[ -n "$token" ] || exit 0

printf 'username=x-access-token\n'
printf 'password=%s\n' "$token"
